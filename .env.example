# Copy to .env for LOCAL DEVELOPMENT ONLY. Never commit a filled-in copy.
#
# Production / unattended runs MUST NOT use this file. They read credentials via
# systemd encrypted credentials (LoadCredentialEncrypted=) or a repo-external
# root-owned 0400 file, referenced by the *_FILE variables below. Only the
# shapeflow-api provider identity may read them; runner/infer identities get an
# explicit environment allowlist that excludes every variable in this file.

# --- preferred: path-based injection (production) ---
TAVILY_API_KEY_FILE=
DEEPSEEK_API_KEY_FILE=

# --- local development fallback only ---
TAVILY_API_KEY=
DEEPSEEK_API_KEY=

# --- optional provider configuration ---
# Resolved once at launch and written into the freeze manifest; never hardcoded.
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_JUDGE_MODEL=

# --- determinism ---
PYTHONHASHSEED=0
TZ=UTC
