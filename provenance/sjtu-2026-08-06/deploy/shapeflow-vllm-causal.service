# shapeflow-vllm-causal unit (plan sections 5.4, 17.2). The PRIMARY causal/quality layer.
#
# One upstream request in flight, prefix caching OFF, chunked prefill OFF. These are not
# performance defaults -- they are what makes the quality and mechanism comparison valid. A
# causal arm that ran with APC on shares KV state across arms, so P1's measured work would
# include cache hits P0 never got and the two arms would no longer be comparable.
#
# This unit and shapeflow-vllm-operational.service are mutually exclusive (Conflicts=) because
# they serve the same port and the same GPU with deliberately different engine semantics.
# Running both would silently mix measurement layers.
#
# Every flag below is asserted against configs/stack.yaml `isolation.causal` by doctor before
# the coordinator will use this engine. Fill @PLACEHOLDERS@.
[Unit]
Description=ShapeFlow P1 vLLM engine (causal layer: single-inflight, APC off)
After=network.target
Conflicts=shapeflow-vllm-operational.service
# At most 3 restarts in 30 min, else give up. These directives belong in [Unit]; systemd
# ignores them under [Service], which silently disables the crash ceiling entirely.
StartLimitIntervalSec=1800
StartLimitBurst=3

[Service]
Type=simple
User=sfinfer
WorkingDirectory=/storage/nvme/shapeflow-p1-study
RuntimeDirectory=shapeflow-vllm-causal
RuntimeDirectoryMode=0755
# A stack digest is not a boot id. systemd gives each invocation a fresh INVOCATION_ID; persist
# it where the runner can read it before assigning any cell, so a vLLM restart cannot splice a
# paired block while appearing to be the same epoch.
ExecStartPre=/storage/nvme/shapeflow-p1-study/.venv/bin/python /storage/nvme/shapeflow-p1-study/scripts/write_engine_epoch.py /run/shapeflow-vllm-causal/engine_epoch
# Reuses the pinned existing vLLM as a read-only executable; never installs into its venv.
# --revision is deliberately absent: the model is a local directory, and vLLM's --revision
# only selects a hub commit. The revision is pinned and verified separately, from the HF
# download metadata, by freeze-stack and doctor -- a flag that silently does nothing is
# worse than no flag, because it reads as a check that is not happening.
ExecStart=/storage/nvme/drbat/.venv/bin/python -m vllm.entrypoints.openai.api_server \
  --model /storage/nvme/reme/models/Qwen3-14B-AWQ --served-model-name Qwen3-14B-AWQ \
  --host 127.0.0.1 --port 8000 \
  --max-model-len 16384 --gpu-memory-utilization 0.90 \
  --max-num-seqs 1 \
  --no-enable-prefix-caching \
  --no-enable-chunked-prefill \
  --enable-auto-tool-choice --tool-call-parser hermes

Restart=on-failure
RestartSec=30

UMask=0077
NoNewPrivileges=true
PrivateTmp=true
# The device is frozen by UUID, never index: indices renumber across driver reloads and a
# renumbered index would silently move the campaign onto a different card.
Environment=PYTHONHASHSEED=0 TZ=UTC CUDA_VISIBLE_DEVICES=GPU-ef013951-e496-78da-da70-a5a289dcc634
# Nothing is fetched at serve time: the frozen weights are the ones that load.
Environment=HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1
# The pinned venv's bin must be on PATH or flashinfer's JIT cannot find ninja and the
# engine dies initialising the KV cache. FLASH_ATTN pins the prebuilt kernel: the
# default selection JIT-compiles FlashInfer against the system CUDA, which is 11 here
# while torch is built for 12.9. Which kernel served the run is part of the frozen
# stack, and freeze-stack records it from this engine's own log.
Environment=PATH=/storage/nvme/drbat/.venv/bin:/usr/local/bin:/usr/bin:/bin
Environment=VLLM_ATTENTION_BACKEND=FLASH_ATTN VLLM_USE_FLASHINFER_SAMPLER=0
Environment=HOME=/tmp
# Binds 127.0.0.1 only; no external exposure.

StandardOutput=append:/storage/nvme/shapeflow-p1-study/logs/vllm-causal.log
StandardError=append:/storage/nvme/shapeflow-p1-study/logs/vllm-causal.err

[Install]
WantedBy=multi-user.target
