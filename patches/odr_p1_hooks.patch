+# --- ShapeFlow P1 helpers ---------------------------------------------------------------
+
+
+def _sf_state_hash(researcher_messages):
+    """Digest of the researcher state the batch is being published from.
+
+    Part of the checkpoint identity: two forks that started from different conversation state
+    are not comparable, however similar their batches look.
+    """
+    from shapeflow_p1.hashing import sha256_hex
+    from shapeflow_p1.odr.adapter import freeze_messages
+    from shapeflow_p1.canonical import canonical_json
+
+    frozen = freeze_messages(researcher_messages)
+    return sha256_hex(canonical_json([m.content_dict() for m in frozen]))
+
+
+def _sf_close_reason(state, configurable):
+    """Classify the close on the same signals vendor branches on.
+
+    All three exits enter the same treatment policy; the label exists so the analysis can tell
+    them apart afterwards, not so any of them can be treated differently.
+    """
+    from shapeflow_p1.odr.close_reason import classify_close
+
+    messages = state.get("researcher_messages", [])
+    # On a late exit vendor has already appended ToolMessage results, so messages[-1] is not
+    # the assistant decision that closed the researcher. Walk back to the latest AIMessage;
+    # on the no-tool path that is still the last message.
+    last_ai = next(
+        (message for message in reversed(messages)
+         if getattr(message, "type", "") == "ai"),
+        None,
+    )
+    tool_calls = list(getattr(last_ai, "tool_calls", None) or [])
+    has_native_search = bool(
+        last_ai and (
+            openai_websearch_called(last_ai) or anthropic_websearch_called(last_ai)
+        )
+    )
+    reason = classify_close(
+        has_tool_calls=bool(tool_calls),
+        has_native_search=has_native_search,
+        research_complete_called=any(tc.get("name") == "ResearchComplete" for tc in tool_calls),
+        tool_call_iterations=state.get("tool_call_iterations", 0),
+        max_react_tool_calls=configurable.max_react_tool_calls,
+    )
+    return reason.value if reason is not None else "NO_TOOL_CALL"
