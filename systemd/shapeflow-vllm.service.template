# shapeflow-vllm unit (plan §5, §17.2). Serves the frozen local target model. Runs as the infer
# identity with NO credential access. The engine config (model revision, quantization, KV dtype,
# max_model_len, APC/chunked-prefill, attention backend) is doctor-verified against configs/stack.yaml
# before the coordinator will use it. Fill @PLACEHOLDERS@.
[Unit]
Description=ShapeFlow P1 vLLM engine (frozen target model)
After=network.target

[Service]
Type=simple
User=@INFER_USER@
WorkingDirectory=@REPO@
# Reuses the pinned existing vLLM as a read-only executable; never installs into its venv.
ExecStart=@VLLM_VENV@/bin/python -m vllm.entrypoints.openai.api_server \
  --model @MODEL_PATH@ --revision @MODEL_REVISION@ \
  --host 127.0.0.1 --port @VLLM_PORT@ \
  --max-model-len 16384 --gpu-memory-utilization 0.90 \
  --enable-prefix-caching --enable-chunked-prefill

Restart=on-failure
RestartSec=30
StartLimitIntervalSec=1800
StartLimitBurst=3

UMask=0077
NoNewPrivileges=true
PrivateTmp=true
# Binds 127.0.0.1 only; no external exposure.
Environment=PYTHONHASHSEED=0 TZ=UTC CUDA_VISIBLE_DEVICES=@GPU_INDEX@

StandardOutput=append:@REPO@/logs/vllm.log
StandardError=append:@REPO@/logs/vllm.err

[Install]
WantedBy=multi-user.target
