# --- secrets: never commit ---
.env
.env.*
!.env.example
secrets/
*.pem
*.key

# --- experiment data & run state (never in git) ---
data/
runs/
logs/
object_store/
*.sqlite
*.sqlite-wal
*.sqlite-shm

# --- patched vendor materialization (rebuilt by bootstrap) ---
.build/

# --- generated reports/exports (only redacted finals are copied out by hand) ---
reports/*
!reports/README.md
exports/*
!exports/.gitkeep
manifests/*
!manifests/.gitkeep

# --- python ---
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.hypothesis/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# --- os / editor ---
.DS_Store
Thumbs.db
.idea/
.vscode/

# Materialized vendor trees: reproduced by scripts/materialize_vendor.sh from the pinned
# submodule plus patches/odr_p1_hooks.patch, and pinned by patches/patched_tree.sha256.
# Committing them would create a second copy of vendor that could drift from the first.
.build/
