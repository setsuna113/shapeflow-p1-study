{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shapeflow-p1/schemas/provider_request.schema.json",
  "title": "ProviderRequest",
  "description": "The closed request shapes the provider accepts (plan \u00a73.1: strict allowlist, closed schemas, no arbitrary URL/header/body forwarding). Every credential slot must carry the provider placeholder, never a real value -- a client that could send its own key would have had one in memory, which is exactly what this boundary exists to prevent. The chat-completions shape is closed too: an unrecognised field is refused by name rather than forwarded, so a caller cannot smuggle an engine parameter past the frozen serving configuration.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "route": {
      "type": "string",
      "enum": [
        "tavily.search",
        "deepseek.chat",
        "cells.register",
        "cells.work",
        "canary.audit",
        "chat.completions"
      ]
    }
  },
  "$defs": {
    "tavily.search": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "api_key",
        "query",
        "search_depth",
        "include_raw_content",
        "include_answer",
        "include_usage",
        "max_results"
      ],
      "properties": {
        "api_key": {
          "const": "@SHAPEFLOW_PROVIDER@"
        },
        "query": {
          "type": "string",
          "minLength": 1
        },
        "search_depth": {
          "type": "string",
          "enum": [
            "basic",
            "advanced"
          ]
        },
        "include_raw_content": {
          "type": [
            "string",
            "boolean"
          ]
        },
        "include_answer": {
          "type": "boolean"
        },
        "include_usage": {
          "type": "boolean"
        },
        "max_results": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "topic": {
          "type": "string"
        },
        "days": {
          "type": "integer",
          "minimum": 1
        },
        "include_domains": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "exclude_domains": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "_task_id": {
          "type": "string"
        },
        "_call_key": {
          "type": "string"
        }
      }
    },
    "deepseek.chat": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "api_key",
        "model",
        "messages",
        "response_format"
      ],
      "properties": {
        "api_key": {
          "const": "@SHAPEFLOW_PROVIDER@"
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "messages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/message"
          }
        },
        "response_format": {
          "description": "JSON mode is mandatory: a free-text judgment cannot be schema-validated and would be scored as if it had been.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "json_object"
            }
          }
        },
        "temperature": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "top_p": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "max_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "stop": {
          "type": [
            "array",
            "string",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "seed": {
          "type": [
            "integer",
            "null"
          ]
        },
        "stream": {
          "const": false
        },
        "_op_class": {
          "type": "string"
        },
        "_work_key": {
          "type": "string"
        },
        "_call_key": {
          "type": "string"
        },
        "reasoning_effort": {
          "description": "DeepSeek's reasoning control, validated server-side (an unknown variant is a 400). Reasoning tokens are billed inside completion_tokens, so this shares the max_tokens ceiling with the JSON answer. Omitted entirely to take the endpoint default.",
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "max",
            "xhigh"
          ]
        },
        "chat_template_kwargs": {
          "description": "vLLM-style template switches, forwarded only for endpoints that have them. This previously claimed DeepSeek's reasoning was a property of the model id rather than a request parameter; that is wrong, and reasoning_effort above is the control it actually exposes.",
          "type": "object",
          "additionalProperties": {
            "type": [
              "boolean",
              "string",
              "number"
            ]
          }
        }
      }
    },
    "cells.register": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cell_token",
        "run_id",
        "task_id",
        "arm_id",
        "variant_id",
        "replicate_id",
        "work_key"
      ],
      "properties": {
        "cell_token": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_\\-]{8,128}$"
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "task_id": {
          "type": "string",
          "minLength": 1
        },
        "arm_id": {
          "type": "string",
          "minLength": 1
        },
        "variant_id": {
          "type": "string",
          "minLength": 1
        },
        "replicate_id": {
          "type": "string"
        },
        "work_key": {
          "type": "string",
          "minLength": 1
        },
        "layer": {
          "type": "string",
          "enum": [
            "causal",
            "operational"
          ]
        }
      }
    },
    "cells.work": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "work_key",
        "require_isolated"
      ],
      "properties": {
        "work_key": {
          "type": "string",
          "minLength": 1
        },
        "require_isolated": {
          "type": "boolean"
        }
      }
    },
    "canary.audit": {
      "description": "Runner-only request for sanitized, exact-work-key canary accounting. It cannot request prompt or response bodies, object references, headers, or credentials.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "work_keys"
      ],
      "properties": {
        "work_keys": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        }
      }
    },
    "canary.audit.response": {
      "description": "Closed, sanitized canary accounting attestation. Only aggregate token counts, selector completion limits, open-attempt counts, and the GPU budget account cross the UID boundary.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "work_keys",
        "work",
        "open_attempts",
        "gpu_budget"
      ],
      "properties": {
        "version": {
          "const": "canary_audit_v1"
        },
        "work_keys": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "work": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "items": {
            "$ref": "#/$defs/canary.audit.work"
          }
        },
        "open_attempts": {
          "type": "integer",
          "minimum": 0
        },
        "gpu_budget": {
          "$ref": "#/$defs/canary.audit.budget"
        }
      }
    },
    "canary.audit.work": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "work_key",
        "open_attempts",
        "settled_gpu_seconds",
        "ops"
      ],
      "properties": {
        "work_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "open_attempts": {
          "type": "integer",
          "minimum": 0
        },
        "settled_gpu_seconds": {
          "description": "Authoritative sum of SETTLED gpu_seconds budget reservations for this exact work key.",
          "type": "number",
          "minimum": 0
        },
        "ops": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/canary.audit.op"
          }
        }
      }
    },
    "canary.audit.op": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "op_class",
        "attempt_count",
        "committed_attempt_count",
        "prompt_tokens",
        "completion_tokens",
        "cached_prompt_tokens",
        "max_completion_tokens_observed",
        "settled_gpu_seconds",
        "selector_request_max_tokens"
      ],
      "properties": {
        "op_class": {
          "type": "string",
          "minLength": 1
        },
        "attempt_count": {
          "type": "integer",
          "minimum": 0
        },
        "committed_attempt_count": {
          "type": "integer",
          "minimum": 0
        },
        "prompt_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "completion_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "cached_prompt_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "max_completion_tokens_observed": {
          "type": "integer",
          "minimum": 0
        },
        "settled_gpu_seconds": {
          "description": "Authoritative sum of SETTLED gpu_seconds budget reservations for this exact work key and op class.",
          "type": "number",
          "minimum": 0
        },
        "selector_request_max_tokens": {
          "type": "array",
          "items": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          }
        }
      }
    },
    "canary.audit.budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resource",
        "cap",
        "reserved",
        "settled",
        "remaining"
      ],
      "properties": {
        "resource": {
          "const": "gpu_seconds"
        },
        "cap": {
          "type": "number",
          "minimum": 0
        },
        "reserved": {
          "type": "number",
          "minimum": 0
        },
        "settled": {
          "type": "number",
          "minimum": 0
        },
        "remaining": {
          "type": "number"
        }
      }
    },
    "chat.completions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "messages"
      ],
      "properties": {
        "model": {
          "type": "string",
          "minLength": 1
        },
        "messages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/message"
          }
        },
        "temperature": {
          "type": [
            "number",
            "null"
          ]
        },
        "top_p": {
          "type": [
            "number",
            "null"
          ]
        },
        "n": {
          "type": [
            "integer",
            "null"
          ]
        },
        "max_tokens": {
          "type": [
            "integer",
            "null"
          ]
        },
        "max_completion_tokens": {
          "type": [
            "integer",
            "null"
          ]
        },
        "stop": {
          "type": [
            "array",
            "string",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "stream": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "stream_options": {
          "type": [
            "object",
            "null"
          ]
        },
        "presence_penalty": {
          "type": [
            "number",
            "null"
          ]
        },
        "frequency_penalty": {
          "type": [
            "number",
            "null"
          ]
        },
        "logit_bias": {
          "type": [
            "object",
            "null"
          ]
        },
        "logprobs": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "top_logprobs": {
          "type": [
            "integer",
            "null"
          ]
        },
        "seed": {
          "type": [
            "integer",
            "null"
          ]
        },
        "user": {
          "type": [
            "string",
            "null"
          ]
        },
        "tools": {
          "type": [
            "array",
            "null"
          ]
        },
        "tool_choice": {
          "type": [
            "string",
            "object",
            "null"
          ]
        },
        "parallel_tool_calls": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "functions": {
          "type": [
            "array",
            "null"
          ]
        },
        "function_call": {
          "type": [
            "string",
            "object",
            "null"
          ]
        },
        "response_format": {
          "type": [
            "object",
            "null"
          ]
        },
        "extra_body": {
          "type": [
            "object",
            "null"
          ]
        },
        "guided_json": {
          "type": [
            "object",
            "string",
            "null"
          ]
        },
        "guided_regex": {
          "type": [
            "string",
            "null"
          ]
        },
        "guided_choice": {
          "type": [
            "array",
            "null"
          ]
        },
        "guided_grammar": {
          "type": [
            "string",
            "null"
          ]
        },
        "guided_decoding_backend": {
          "type": [
            "string",
            "null"
          ]
        },
        "chat_template_kwargs": {
          "type": [
            "object",
            "null"
          ]
        },
        "echo": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "min_p": {
          "type": [
            "number",
            "null"
          ]
        },
        "repetition_penalty": {
          "type": [
            "number",
            "null"
          ]
        },
        "top_k": {
          "type": [
            "integer",
            "null"
          ]
        },
        "ignore_eos": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "skip_special_tokens": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "cache_salt": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "message": {
      "description": "Closed on purpose. An unexpected message field is refused by name rather than forwarded, so a client cannot reach the engine with something the frozen serving configuration never saw.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role"
      ],
      "properties": {
        "role": {
          "type": "string"
        },
        "content": {},
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "tool_calls": {
          "type": [
            "array",
            "null"
          ]
        },
        "tool_call_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "function_call": {
          "type": [
            "object",
            "null"
          ]
        },
        "refusal": {
          "type": [
            "string",
            "null"
          ]
        },
        "reasoning_content": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "exa.search": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "query",
        "type",
        "numResults"
      ],
      "properties": {
        "query": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "description": "Pinned search strategy. 'auto' is absent on purpose: it would let the provider pick per query, so the same query could freeze two different worlds.",
          "enum": [
            "instant",
            "fast",
            "deep-lite",
            "deep",
            "deep-reasoning"
          ]
        },
        "numResults": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "category": {
          "type": [
            "string",
            "null"
          ]
        },
        "contents": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "text": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "maxCharacters": {
                  "type": "integer",
                  "minimum": 1
                },
                "includeHtmlTags": {
                  "type": "boolean"
                }
              }
            },
            "highlights": {
              "type": "boolean"
            }
          }
        },
        "_task_id": {
          "type": "string"
        },
        "_call_key": {
          "type": "string"
        }
      }
    }
  }
}
