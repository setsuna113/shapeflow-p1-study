{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shapeflow/schemas/truth_packet.schema.json",
  "title": "TruthPacket",
  "description": "The frozen ground truth a task is scored against. EVALUATOR-ONLY: it never reaches a selector, aggregator, or preflight. Every accepted atom binds to exact source spans; a fact with no span cannot enter accepted truth, a contradiction has spans on both sides, and a gap binds to a real query attempt rather than a model's assertion. A machine-authored packet is marked MACHINE_CANDIDATE_PENDING_HUMAN_AUDIT and its verdicts stay PROVISIONAL until the audit gate.",
  "type": "object",
  "additionalProperties": false,
  "required": ["task_id", "required_facets", "atomic_evidence", "authoring_method", "verifier_status", "content_sha256"],
  "properties": {
    "task_id": { "type": "string", "minLength": 1 },
    "required_facets": { "type": "array", "items": { "type": "string" } },
    "atomic_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["atom_id", "facet_id", "weight", "critical", "supporting_span_ids"],
        "properties": {
          "atom_id": { "type": "string", "minLength": 1 },
          "facet_id": { "type": "string", "minLength": 1 },
          "weight": { "type": "number", "minimum": 0 },
          "critical": { "type": "boolean" },
          "known_unresolved": { "type": "boolean" },
          "supporting_span_ids": {
            "description": "Exact source spans that carry this atom. Non-empty: an atom with no span is not accepted truth.",
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
          }
        }
      }
    },
    "contradiction_pairs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["atom_id_a", "atom_id_b"],
        "properties": {
          "atom_id_a": { "type": "string" },
          "atom_id_b": { "type": "string" }
        }
      }
    },
    "negative_evidence": {
      "description": "Grounded absence facts, each retaining the accepted atom and frozen query attempt that establish it.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["atom_id", "facet_id", "query_attempt_id"],
        "properties": {
          "atom_id": { "type": "string", "minLength": 1 },
          "facet_id": { "type": "string" },
          "query_attempt_id": { "type": "string" }
        }
      }
    },
    "known_gaps": {
      "description": "Operationally unresolved frozen query attempts. Membership comes only from the acquisition status, never from a truth-authoring model.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["query_attempt_id", "query_text", "status"],
        "properties": {
          "query_attempt_id": { "type": "string", "minLength": 1 },
          "query_text": { "type": "string" },
          "status": { "enum": ["FAILED", "TIMEOUT", "BLOCKED_BUDGET"] }
        }
      }
    },
    "critical_items": { "type": "array", "items": { "type": "string" } },
    "authoring_method": { "enum": ["HUMAN_AUTHORED", "MACHINE_CANDIDATE_PENDING_HUMAN_AUDIT"] },
    "verifier_status": { "enum": ["PENDING", "AUDITED", "REJECTED"] },
    "content_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
